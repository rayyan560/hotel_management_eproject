            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"102\",\n  \"category\": \"Plumbing\",\n  \"issueTitle\": \"Shower drain slow drainage\",\n  \"issueDescription\": \"Water accumulating in shower basin.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/maintenance", "host": ["{{baseUrl}}"], "path": ["api", "maintenance"] }
          }
